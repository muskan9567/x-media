# The main media archive needs NO environment file, login, cookies, or API key.
# These optional settings do not change its anonymous collector.

# Dashboard: blank uses demo data; a token selects the official X API provider.
# Also selects the official provider for legacy POST /api/media-archive.
# Never expose credentials through NEXT_PUBLIC_* variables.
X_BEARER_TOKEN=

# Official-compatible base. HTTPS required except for loopback development.
X_API_BASE_URL=https://api.x.com/2

# Dashboard storage and limits, resolved from the project root.
TRACKER_DATA_FILE=.data/tracker-state.json
MAX_TRACKED_ACCOUNTS=25
DATA_RETENTION_DAYS=30

# Required only for the optional GET /api/cron/sync endpoint.
CRON_SECRET=

# Legacy synchronous API only. These do NOT affect the main media archive.
# Both cookies are required together if choosing this optional legacy provider.
X_SCRAPER_AUTH_TOKEN=
X_SCRAPER_CT0=
X_SCRAPER_MAX_POSTS=10000
X_SCRAPER_TIMEOUT_MS=90000
